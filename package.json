{
  "name": "mathquest-curriculum",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "MathQuest grade curriculum data with explicit topic and formatFamily metadata",
  "scripts": {
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "audit:topics": "node scripts/generate-topic-audit.mjs",
    "audit:standards": "node scripts/generate-topic-audit.mjs",
    "test": "node --test tests/curriculum-metadata.test.mjs tests/curriculum-standards.test.mjs",
    "test:curriculum": "npm run validate:curriculum && npm test"
  },
  "exports": {
    "./types/curriculum": "./types/curriculum.ts",
    "./curriculum-engine": "./src/curriculum-engine.mjs",
    "./topic-labels": "./src/topic-labels.mjs"
  }
}
