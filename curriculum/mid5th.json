        {
          "id": "fm_005",
          "type": "APPLY",
          "context": "technology",
          "problem": "A battery starts at {a}% charge. After using a device it drops by {b} percentage points. What percent charge remains?",
          "constraints": {
            "a": [
              50,
              100
            ],
            "b": [
              5,
              40
            ]
          },
          "answer_type": "numeric",
          "answer_formula": "a - b"
        },
        {
          "id": "fm_006",
          "type": "REVERSE",
          "problem": "{a} {b}/{c} + __ = {d} {e}/{c}. Find the missing mixed number.",
          "constraints": {
            "a": [
              1,
              3
            ],
            "b": [
              1,
              4
